{
  "name": "damas-vision",
  "version": "0.1.0-rc.1",
  "description": "Local-first web app that tracks a physical Brazilian 64-square checkers board through a camera.",
  "private": true,
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:engine": "ng test --watch=false --include=src/app/domain/**/*.spec.ts",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:prod": "playwright test --config=playwright.prod.config.ts && prettier --write docs/testing/performance.md",
    "eval:recognition": "node scripts/eval-recognition.mjs",
    "validate": "npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@angular/service-worker": "22.3.0",
    "@techstark/opencv-js": "5.0.0-release.1",
    "dexie": "4.4.7",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.1"
  }
}
